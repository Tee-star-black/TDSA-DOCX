{
  "name": "tdsa-docx",
  "version": "0.4.0",
  "private": true,
  "description": "Centralised Compliance and HR document hub for PostgreSQL and GCP",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/runtime/main.js",
    "dev": "node --env-file-if-exists=.env --watch src/runtime/main.js",
    "preview": "node scripts/preview.js",
    "legacy:preview": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "import:documents": "python scripts/import_documents.py",
    "db:init": "node --env-file-if-exists=.env scripts/database.js init",
    "db:status": "node --env-file-if-exists=.env scripts/database.js status",
    "db:restore": "node --env-file-if-exists=.env scripts/database.js restore",
    "pg:plan": "node scripts/postgres.js plan",
    "pg:migrate": "node --env-file-if-exists=.env scripts/postgres.js migrate",
    "migration:export": "node --env-file-if-exists=.env scripts/migration-export.js export",
    "migration:verify": "node --env-file-if-exists=.env scripts/migration-export.js verify"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "google-auth-library": "^11.3.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
